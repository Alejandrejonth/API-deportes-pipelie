			"name": "Lista los equipos por deporte y país",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Obtener un país aleatorio usando la función integrada de Postman\r",
							"const randomCountry = pm.variables.replaceIn(\"{{$randomCountry}}\");\r",
							"\r",
							"// Crear/actualizar la variable global\r",
							"pm.globals.set(\"country\", randomCountry);\r",
							"\r",
							"console.log(\"Variable global 'country' asignada:\", randomCountry);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Prueba que la respuesta contenga un encabezado Content-Type\", function () {\r",
							"pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"Los campos idTeam, strTeam e intFormedYear no contienen valores nulos\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    // Convertimos la respuesta a un arreglo, sin importar si es objeto o array\r",
							"    const teams = Array.isArray(json) ? json : [json];\r",
							"\r",
							"    teams.forEach((team, index) => {\r",
							"        pm.expect(team.idTeam, `idTeam es nulo en el elemento #${index}`).to.not.be.null;\r",
							"        pm.expect(team.strTeam, `strTeam es nulo en el elemento #${index}`).to.not.be.null;\r",
							"        pm.expect(team.intFormedYear, `intFormedYear es nulo en el elemento #${index}`).to.not.be.null;\r",
							"    });\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
